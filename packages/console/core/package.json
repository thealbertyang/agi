{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@opencode-ai/console-core",
	"version": "1.0.199",
	"private": true,
	"type": "module",
	"exports": {
		"./*": "./src/*"
	},
	"scripts": {
		"db": "sst shell drizzle-kit",
		"db-dev": "sst shell --stage dev -- drizzle-kit",
		"db-prod": "sst shell --stage production -- drizzle-kit",
		"shell": "sst shell -- bun",
		"shell-dev": "sst shell --stage dev -- bun",
		"shell-prod": "sst shell --stage production -- bun",
		"update-models": "script/update-models.ts",
		"promote-models-to-dev": "script/promote-models.ts dev",
		"promote-models-to-prod": "script/promote-models.ts production",
		"pull-models-from-dev": "script/pull-models.ts dev",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-sts": "catalog:backend",
		"@jsx-email/render": "catalog:utilities",
		"@opencode-ai/console-mail": "workspace:*",
		"@opencode-ai/console-resource": "workspace:*",
		"@planetscale/database": "catalog:utilities",
		"aws4fetch": "catalog:utilities",
		"drizzle-orm": "catalog:database",
		"postgres": "catalog:database",
		"stripe": "catalog:utilities",
		"ulid": "catalog:utilities",
		"zod": "catalog:validation"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:utilities",
		"@tsconfig/node22": "catalog:utilities",
		"@types/bun": "catalog:runtime",
		"@types/node": "catalog:runtime",
		"@typescript/native-preview": "catalog:types",
		"drizzle-kit": "catalog:database",
		"mysql2": "catalog:utilities",
		"typescript": "catalog:types"
	}
}
