{
	"name": "@opencode-ai/console-app",
	"version": "1.0.199",
	"type": "module",
	"scripts": {
		"typecheck": "tsgo --noEmit",
		"dev": "vite dev --host 0.0.0.0",
		"dev:remote": "VITE_AUTH_URL=https://auth.dev.opencode.ai bun sst shell --stage=dev bun dev",
		"build": "./script/generate-sitemap.ts && vite build && ../../opencode/script/schema.ts ./.output/public/config.json",
		"start": "vite start"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "catalog:tooling",
		"@ibm/plex": "catalog:utilities",
		"@jsx-email/render": "catalog:utilities",
		"@kobalte/core": "catalog:utilities",
		"@openauthjs/openauth": "catalog:utilities",
		"@opencode-ai/console-core": "workspace:*",
		"@opencode-ai/console-mail": "workspace:*",
		"@opencode-ai/console-resource": "workspace:*",
		"@opencode-ai/ui": "workspace:*",
		"@solidjs/meta": "catalog:utilities",
		"@solidjs/router": "catalog:utilities",
		"@solidjs/start": "catalog:utilities",
		"chart.js": "catalog:utilities",
		"nitro": "catalog:utilities",
		"solid-js": "catalog:utilities",
		"vite": "catalog:utilities",
		"zod": "catalog:validation"
	},
	"devDependencies": {
		"@typescript/native-preview": "catalog:types",
		"typescript": "catalog:types",
		"wrangler": "catalog:utilities"
	},
	"engines": {
		"node": ">=22"
	}
}
