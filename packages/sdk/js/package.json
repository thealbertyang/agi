{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@opencode-ai/sdk",
	"version": "1.0.199",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./server": "./src/server.ts",
		"./v2": "./src/v2/index.ts",
		"./v2/client": "./src/v2/client.ts",
		"./v2/server": "./src/v2/server.ts"
	},
	"publishConfig": {
		"directory": "dist"
	},
	"scripts": {
		"typecheck": "tsgo --noEmit",
		"build": "./script/build.ts"
	},
	"dependencies": {},
	"devDependencies": {
		"@hey-api/openapi-ts": "catalog:utilities",
		"@tsconfig/node22": "catalog:utilities",
		"@types/node": "catalog:runtime",
		"@typescript/native-preview": "catalog:types",
		"typescript": "catalog:types"
	}
