{
	"name": "@opencode-ai/ui",
	"version": "1.0.199",
	"type": "module",
	"exports": {
		"./*": "./src/components/*.tsx",
		"./pierre": "./src/pierre/index.ts",
		"./pierre/*": "./src/pierre/*.ts",
		"./hooks": "./src/hooks/index.ts",
		"./context": "./src/context/index.ts",
		"./context/*": "./src/context/*.tsx",
		"./styles": "./src/styles/index.css",
		"./styles/tailwind": "./src/styles/tailwind/index.css",
		"./icons/provider": "./src/components/provider-icons/types.ts",
		"./icons/file-type": "./src/components/file-icons/types.ts",
		"./fonts/*": "./src/assets/fonts/*",
		"./audio/*": "./src/assets/audio/*"
	},
	"scripts": {
		"typecheck": "tsgo --noEmit",
		"dev": "vite",
		"generate:tailwind": "bun run script/tailwind.ts"
	},
	"dependencies": {
		"@kobalte/core": "catalog:utilities",
		"@opencode-ai/sdk": "workspace:*",
		"@opencode-ai/util": "workspace:*",
		"@pierre/diffs": "catalog:utilities",
		"@shikijs/transformers": "catalog:utilities",
		"@solid-primitives/bounds": "catalog:utilities",
		"@solid-primitives/resize-observer": "catalog:utilities",
		"@solidjs/meta": "catalog:utilities",
		"@typescript/native-preview": "catalog:types",
		"fuzzysort": "catalog:utilities",
		"luxon": "catalog:utilities",
		"marked": "catalog:content",
		"marked-shiki": "catalog:utilities",
		"remeda": "catalog:utilities",
		"shiki": "catalog:utilities",
		"solid-js": "catalog:utilities",
		"solid-list": "catalog:utilities",
		"virtua": "catalog:utilities"
	},
	"devDependencies": {
		"@tailwindcss/vite": "catalog:utilities",
		"@tsconfig/node22": "catalog:utilities",
		"@types/bun": "catalog:runtime",
		"@types/luxon": "catalog:types",
		"tailwindcss": "catalog:frontend",
		"typescript": "catalog:types",
		"vite": "catalog:utilities",
		"vite-plugin-icons-spritesheet": "catalog:tooling",
		"vite-plugin-solid": "catalog:tooling"
	}
}
